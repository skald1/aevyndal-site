---
import type { CountryEntry } from "../data/atlas/types";
import wordmark from "../assets/Aevyndal-Wordmark-v1-WhiteBlood.png";

interface Props { entry: CountryEntry }
const { entry } = Astro.props;

const ageNames = ["", "Age of Creation", "Chaos & God-Kings", "Expansion of Empires", "Age of Exploration", "Fall of the Gods", "Rise of Science", "Rise of the Syndicate", "Dawn of Hope"];
const ordinal = (n: number) => `${n}${n === 1 ? "st" : n === 2 ? "nd" : n === 3 ? "rd" : "th"}`;

// A burnt edge under the masthead, unique to each country (seeded by slug).
let seed = [...entry.slug].reduce((a, c) => a * 31 + c.charCodeAt(0), 7) >>> 0;
const rand = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 2 ** 32);
const pts: string[] = ["0% 0%", "100% 0%"];
let y = 94;
for (let x = 100; x >= 0; x -= 1.25) { y = Math.min(100, Math.max(86, y + (rand() - 0.5) * 5)); pts.push(`${x}% ${y.toFixed(1)}%`); }
const edge = `polygon(${pts.join(",")})`;

const sections = [
  entry.growingUp && ["growing-up", "Growing up here"],
  entry.trouble && ["trouble", "Trouble here"],
  entry.now && ["now", entry.now.title],
  entry.places && ["places", "Places"],
  entry.people && ["people", "The people"],
  entry.history && ["history", entry.history.title],
  ["ages", "Across the Ages"],
].filter(Boolean) as [string, string][];

const title = `${entry.name} | Atlas of Erinnal`;
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<title>{title}</title>
<meta name="description" content={entry.lede} />
<meta property="og:title" content={title} />
<meta property="og:description" content={entry.lede} />
<meta name="theme-color" content="#1a1a18" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Crimson+Text:ital,wght@0,400;0,600;0,700;1,400&family=Lora:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet" />
<style is:global>
  /* Layout: a gazetteer page on bone paper. Charred masthead, one reading column, the Ledger alongside. */
  :root{
    --soot:#1a1a18; --bone:#d4cfc4; --paper:#e4dfd4; --ink:#1f1d1a;
    --ash:#8a8172; --ash-ink:#5a5348; --blood:#7a2020; --char:#3b2b20;
    --display:"Crimson Text", Georgia, serif;
    --body:Lora, Georgia, serif;
    --gutter:clamp(1.1rem, 5vw, 4rem);
    color-scheme:light;
  }
  *{box-sizing:border-box}
  html{background:var(--soot);scroll-behavior:smooth}
  body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--body);font-size:1.0625rem;line-height:1.75;-webkit-font-smoothing:antialiased}
  a{color:inherit}
  :focus-visible{outline:2px solid var(--blood);outline-offset:3px}

  .mast{position:relative;z-index:2;background:var(--soot);color:var(--bone);padding:1rem var(--gutter) 7rem;clip-path:var(--edge)}
  .mast-char{position:relative;height:0}
  .mast-char::before{content:"";position:absolute;left:0;right:0;bottom:-.45rem;height:7rem;background:var(--char);clip-path:var(--edge);opacity:.8;z-index:1}
  .top{display:flex;align-items:center;justify-content:space-between;gap:1rem}
  .top img{width:150px;height:auto;display:block}
  .top a{font-size:.95rem;text-decoration:none;opacity:.8}
  .top a:hover{opacity:1;text-decoration:underline;text-underline-offset:.25em}
  .mast-inner{max-width:72rem;margin:clamp(3rem,9vw,6rem) auto 0}
  .where{margin:0;font-family:var(--display);font-style:italic;font-size:1.15rem;color:#b4ad9f}
  .mast h1{margin:.2rem 0 0;font-family:var(--display);font-weight:600;font-size:clamp(3.6rem,13vw,9rem);line-height:.9;letter-spacing:-.01em}
  .mast-sub{margin:.9rem 0 0;font-family:var(--display);font-size:clamp(1.25rem,2.6vw,1.6rem);line-height:1.3}
  .mast-sub i{color:#b4ad9f}

  main{max-width:72rem;margin:0 auto;padding:1rem var(--gutter) 5rem}
  .lede{margin:0 0 3.5rem;max-width:34ch;font-family:var(--display);font-size:clamp(1.55rem,3.4vw,2.15rem);line-height:1.32;text-wrap:pretty}

  .grid{display:grid;gap:3.5rem}
  .col{min-width:0;display:grid;gap:4.5rem}
  section{scroll-margin-top:1.5rem}
  h2{margin:0 0 .4rem;font-family:var(--display);font-weight:600;font-size:clamp(2rem,4.4vw,2.7rem);line-height:1.05;text-wrap:balance}
  .intro{margin:0 0 1.6rem;color:var(--ash-ink);font-style:italic}
  h3{margin:0;font-family:var(--display);font-weight:600;font-size:1.4rem;line-height:1.25}
  p{margin:0}
  .prose{display:grid;gap:1.1rem;max-width:62ch}

  .ways{display:grid;gap:1.6rem}
  .way{padding-left:1.2rem;border-left:2px solid var(--blood)}
  .way p{margin-top:.25rem;max-width:58ch}
  .note{margin-top:1.6rem;color:var(--ash-ink);font-size:.98rem}

  .troubles{list-style:none;margin:0;padding:0;display:grid;gap:0}
  .troubles li{padding:1.15rem 0;border-top:1px solid color-mix(in srgb,var(--ash) 45%,transparent)}
  .troubles li:last-child{border-bottom:1px solid color-mix(in srgb,var(--ash) 45%,transparent)}
  .troubles h3{color:var(--blood)}
  .troubles p{margin-top:.3rem;max-width:58ch}

  .now{background:var(--soot);color:var(--bone);padding:2.2rem clamp(1.2rem,4vw,2.6rem) 2.4rem;margin-inline:calc(var(--gutter) * -1)}
  .now h2{color:#efe9dd}
  .now .intro{color:#b4ad9f}

  .places{display:grid;gap:1.8rem}
  .places p{margin-top:.25rem;max-width:58ch}

  details{margin-top:1.1rem;max-width:62ch}
  summary{display:inline-flex;align-items:center;gap:.6rem;cursor:pointer;list-style:none;font-family:var(--display);font-size:1.25rem;font-style:italic;color:var(--blood);padding:.4rem 0}
  summary::-webkit-details-marker{display:none}
  summary::after{content:"";width:.55rem;height:.55rem;border-right:1.5px solid currentColor;border-bottom:1.5px solid currentColor;transform:rotate(45deg) translateY(-3px);transition:transform .2s ease}
  details[open] summary::after{transform:rotate(-135deg) translate(-2px,-1px)}
  details[open] summary .more{display:none}
  details:not([open]) summary .less{display:none}
  details .prose{margin-top:1rem}

  .ledger{order:-1;align-self:start;border-top:3px solid var(--ink);padding-top:1rem}
  .ledger h2{font-size:1.7rem}
  .ledger dl{margin:.6rem 0 0;display:grid;gap:0}
  .ledger dl div{padding:.6rem 0;border-bottom:1px solid color-mix(in srgb,var(--ash) 40%,transparent)}
  .ledger dt{font-family:var(--display);font-style:italic;font-size:1rem;color:var(--ash-ink)}
  .ledger dd{margin:0;font-size:.98rem;line-height:1.5}
  .toc{display:none}

  .ages ol{list-style:none;margin:1.2rem 0 0;padding:0;display:grid;gap:0}
  .ages li{display:grid;grid-template-columns:4.2rem 1fr;gap:.2rem 1rem;padding:.9rem 0;border-top:1px solid color-mix(in srgb,var(--ash) 45%,transparent)}
  .ages .n{font-family:var(--display);font-size:1.7rem;line-height:1;color:var(--ash)}
  .ages .nm{font-family:var(--display);font-size:1.15rem;line-height:1.2}
  .ages .tx{grid-column:2;font-size:.98rem;max-width:58ch}
  .ages .none{grid-column:2;font-style:italic;color:var(--ash-ink);font-size:.95rem}
  .ages li.has .n{color:var(--ink)}
  .ages li.cur{border-top:3px solid var(--blood)}
  .ages li.cur .n{color:var(--blood)}
  .ages .here{display:block;font-family:var(--body);font-style:italic;font-size:.9rem;color:var(--blood)}

  .foot{max-width:72rem;margin:0 auto;padding:2rem var(--gutter) 3rem;display:flex;flex-wrap:wrap;justify-content:space-between;gap:1rem;color:var(--ash-ink);font-size:.95rem;border-top:1px solid color-mix(in srgb,var(--ash) 45%,transparent)}

  @media (min-width:960px){
    .grid{grid-template-columns:minmax(0,1fr) 19rem;gap:5rem}
    .ledger{order:0;align-self:stretch}
    .toc{display:block;position:sticky;top:1.5rem;margin-top:2rem}
    .toc h2{font-size:1.25rem}
    .toc ul{list-style:none;margin:.4rem 0 0;padding:0;display:grid;gap:.25rem}
    .toc a{text-decoration:none;color:var(--ash-ink);font-size:.95rem}
    .toc a:hover,.toc a.on{color:var(--blood);text-decoration:underline;text-underline-offset:.25em}
    .now{margin-inline:0}
    .ages ol{grid-template-columns:repeat(4,1fr);gap:0 1.5rem}
    .ages li{grid-template-columns:1fr;align-content:start}
    .ages .tx,.ages .none{grid-column:1}
  }
  @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none !important}}
</style>
</head>
<body style={`--edge:${edge}`}>
  <header class="mast">
    <nav class="top" aria-label="Site">
      <a href="/" aria-label="Ævyndal home"><img src={wordmark.src} width={wordmark.width} height={wordmark.height} alt="Ævyndal" /></a>
      <a href="/atlas">Atlas of Erinnal</a>
    </nav>
    <div class="mast-inner">
      <p class="where">The {ordinal(entry.age)} Age, {ageNames[entry.age]}</p>
      <h1>{entry.name}</h1>
      <p class="mast-sub">{entry.epithet}. <i>Said {entry.pronunciation}.</i></p>
    </div>
  </header>
  <div class="mast-char" aria-hidden="true"></div>

  <main>
    <p class="lede">{entry.lede}</p>

    <div class="grid">
      <div class="col">
        {entry.growingUp && (
          <section id="growing-up" aria-labelledby="h-growing-up">
            <h2 id="h-growing-up">Growing up here</h2>
            <p class="intro">{entry.growingUp.intro}</p>
            <div class="ways">
              {entry.growingUp.ways.map((w) => (
                <div class="way"><h3>{w.title}</h3><p>{w.text}</p></div>
              ))}
            </div>
            {entry.growingUp.note && <p class="note">{entry.growingUp.note}</p>}
          </section>
        )}

        {entry.trouble && (
          <section id="trouble" aria-labelledby="h-trouble">
            <h2 id="h-trouble">Trouble here</h2>
            <p class="intro">{entry.trouble.intro}</p>
            <ul class="troubles">
              {entry.trouble.items.map((t) => (<li><h3>{t.title}</h3><p>{t.text}</p></li>))}
            </ul>
          </section>
        )}

        {entry.now && (
          <section id="now" class="now" aria-labelledby="h-now">
            <h2 id="h-now">{entry.now.title}</h2>
            <p class="intro">Who rules now.</p>
            <div class="prose">{entry.now.paragraphs.map((p) => <p>{p}</p>)}</div>
          </section>
        )}

        {entry.places && (
          <section id="places" aria-labelledby="h-places">
            <h2 id="h-places">Places</h2>
            <div class="places">
              {entry.places.map((pl) => (<div><h3>{pl.title}</h3><p>{pl.text}</p></div>))}
            </div>
          </section>
        )}

        {entry.people && (
          <section id="people" aria-labelledby="h-people">
            <h2 id="h-people">The people</h2>
            <div class="prose">{entry.people.map((p) => <p>{p}</p>)}</div>
          </section>
        )}

        {entry.history && (
          <section id="history" aria-labelledby="h-history">
            <h2 id="h-history">{entry.history.title}</h2>
            <div class="prose">{entry.history.teaser.map((p) => <p>{p}</p>)}</div>
            <details>
              <summary><span class="more">Read the whole story</span><span class="less">Close the story</span></summary>
              <div class="prose">{entry.history.rest.map((p) => <p>{p}</p>)}</div>
            </details>
          </section>
        )}
      </div>

      <aside class="ledger" aria-labelledby="h-ledger">
        <h2 id="h-ledger">The Ledger</h2>
        <dl>
          {entry.facts.map((f) => (<div><dt>{f.label}</dt><dd>{f.value}</dd></div>))}
        </dl>
        <nav class="toc" aria-labelledby="h-toc">
          <h2 id="h-toc">On this page</h2>
          <ul>{sections.map(([id, label]) => <li><a href={`#${id}`} data-toc={id}>{label}</a></li>)}</ul>
        </nav>
      </aside>
    </div>

    <section id="ages" class="ages" aria-labelledby="h-ages" style="margin-top:4.5rem">
      <h2 id="h-ages">Across the Ages</h2>
      <p class="intro">What {entry.name} was, is, and becomes.</p>
      <ol>
        {entry.ages.map((a) => (
          <li class:list={{ has: a.text, cur: a.current }}>
            <span class="n">{a.age}</span>
            <span class="nm">{ageNames[a.age]}{a.current && <span class="here">This entry</span>}</span>
            {a.text ? <p class="tx">{a.text}</p> : <p class="none">Not yet charted.</p>}
          </li>
        ))}
      </ol>
    </section>
  </main>

  <footer class="foot">
    <p>{entry.source} Published by <a href="https://grimwell.studio">Grimwell Studio</a>.</p>
    <a href="/atlas">Back to the atlas</a>
  </footer>

  <script>
    const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc]")];
    if (links.length) {
      const io = new IntersectionObserver((es) => es.forEach((e) => {
        if (e.isIntersecting) links.forEach((l) => l.classList.toggle("on", l.dataset.toc === e.target.id));
      }), { rootMargin: "-30% 0px -65% 0px" });
      links.forEach((l) => { const s = document.getElementById(l.dataset.toc!); if (s) io.observe(s); });
    }
  </script>
</body>
</html>
