---
// Site-wide header. One list of destinations for every page.
// `current` marks the section the visitor is in.
// `variant="home"` floats over the homepage hero and turns solid on scroll.
import wordmark from "../assets/Aevyndal-Wordmark-v1-WhiteBlood.png";

interface Props {
  current?: "ages" | "atlas" | "unspoken";
  variant?: "page" | "home";
}
const { current, variant = "page" } = Astro.props;

const links = [
  { key: "ages", label: "The Ages", href: "/#ages" },
  { key: "atlas", label: "Atlas of Erinnal", href: "/atlas" },
  { key: "unspoken", label: "The Unspoken", href: "/unspoken" },
  { key: "studio", label: "Grimwell Studio", href: "https://grimwell.studio" },
];
---

<header class:list={["sh", { "sh--home": variant === "home" }]} data-sh>
  <a class="sh-home" href="/" aria-label="Ævyndal home"><img src={wordmark.src} width={wordmark.width} height={wordmark.height} alt="Ævyndal" /></a>
  <nav class="sh-wide" aria-label="Primary">
    {links.map((l) => <a href={l.href} data-key={l.key} aria-current={l.key === current ? "page" : undefined}>{l.label}</a>)}
  </nav>
  <details class="sh-narrow">
    <summary>Menu</summary>
    <nav aria-label="Primary">
      {links.map((l) => <a href={l.href} data-key={l.key} aria-current={l.key === current ? "page" : undefined}>{l.label}</a>)}
    </nav>
  </details>
</header>

<style>
  .sh{position:relative;z-index:30;display:flex;align-items:center;justify-content:space-between;gap:1.5rem;font-family:"Crimson Text",Georgia,serif;color:#d4cfc4}
  .sh-home img{width:150px;height:auto;display:block;transition:width .35s ease}
  .sh a{color:inherit;text-decoration:none}
  .sh-wide{display:none;gap:2rem;font-size:1.1rem}
  .sh-wide a{position:relative;opacity:.78;padding:.25rem 0;transition:opacity .2s ease}
  .sh-wide a::after{content:"";position:absolute;left:0;right:100%;bottom:0;height:1px;background:currentColor;transition:right .35s ease}
  .sh-wide a:hover{opacity:1}
  .sh-wide a:hover::after{right:0}
  .sh-wide a[aria-current="page"],.sh-wide a.on{opacity:1}
  .sh-wide a[aria-current="page"]::after,.sh-wide a.on::after{right:0;height:2px;background:#7a2020}
  .sh-narrow{position:relative}
  .sh-narrow summary{list-style:none;cursor:pointer;font-size:1.1rem;padding:.4rem .2rem}
  .sh-narrow summary::-webkit-details-marker{display:none}
  .sh-narrow nav{position:absolute;right:0;top:calc(100% + .4rem);min-width:13rem;display:grid;background:#1a1a18;border:1px solid #3b3833;padding:.4rem 0}
  .sh-narrow nav a{padding:.65rem 1rem;font-size:1.1rem}
  .sh-narrow nav a[aria-current="page"],.sh-narrow nav a.on{color:#efe9dd;border-left:2px solid #7a2020}
  .sh :focus-visible{outline:2px solid #d4cfc4;outline-offset:3px}

  /* Homepage: floats over the hero, then settles into a solid bar */
  .sh--home{position:fixed;inset:0 0 auto 0;height:84px;padding:0 4vw;background:linear-gradient(180deg,rgba(7,9,13,.9),rgba(7,9,13,0));transition:height .35s ease,background-color .35s ease,box-shadow .35s ease}
  .sh--home .sh-home img{width:210px}
  .sh--home .sh-wide{gap:2.6rem;font-size:1.2rem;letter-spacing:.01em}
  .sh--home.is-solid{height:64px;background:rgba(17,16,15,.94);backdrop-filter:blur(8px);box-shadow:inset 0 -1px 0 rgba(122,32,32,.7)}
  .sh--home.is-solid .sh-home img{width:150px}
  .sh--home .sh-narrow nav{position:fixed;left:0;right:0;top:64px;min-width:0;border-width:1px 0;padding:.6rem 0}
  .sh--home .sh-narrow nav a{padding:.9rem 20px;font-size:1.25rem}

  @media (max-width:819px){
    .sh--home{height:64px;padding:0 20px}
    .sh--home .sh-home img{width:150px}
  }
  @media (min-width:820px){.sh-wide{display:flex}.sh-narrow{display:none}}
  @media (prefers-reduced-motion:reduce){.sh,.sh *{transition:none !important}}
</style>

<script>
  const bar = document.querySelector<HTMLElement>(".sh--home");
  if (bar) {
    const settle = () => bar.classList.toggle("is-solid", window.scrollY > 40);
    settle();
    window.addEventListener("scroll", settle, { passive: true });

    // Underline "The Ages" while that section is on screen.
    const ages = document.getElementById("ages");
    const agesLinks = bar.querySelectorAll<HTMLAnchorElement>('a[data-key="ages"]');
    if (ages && agesLinks.length) {
      new IntersectionObserver(([e]) => agesLinks.forEach((a) => a.classList.toggle("on", e.isIntersecting)), {
        rootMargin: "-40% 0px -50% 0px",
      }).observe(ages);
    }

    // Close the phone menu after a link is chosen.
    const menu = bar.querySelector<HTMLDetailsElement>(".sh-narrow");
    menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => menu.removeAttribute("open")));
  }
</script>
